@echo off
chcp 65001 >nul
REM ============================================================
REM 阅读笔记系统 —— SQLite 迁移执行器（Windows 入口）
REM 依赖：Python 3（内置 sqlite3 模块，无需额外安装 sqlite3 CLI）
REM ============================================================

cd /d "%~dp0"

echo ============================================================
echo  应用数据库迁移
echo  数据库: .\data\notes.db
echo ============================================================
echo.

python apply.py %*

if errorlevel 1 (
    echo.
    echo [错误] 迁移执行失败，请查看上方报错信息
    exit /b 1
)

echo.
echo [成功] 数据库已就绪
pause
